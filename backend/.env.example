# ========================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Play The Game Store — API REST con Express y PostgreSQL
#
# INSTRUCCIONES DE USO:
# 1. Duplica este archivo y renómbralo exactamente como ".env"
# 2. Reemplaza los valores de ejemplo con tus credenciales reales locales
# ========================================================================

# Puerto HTTP donde escuchará el servidor Express
PORT=3000

# Credenciales y parámetros de conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=catalogo_juegos_db
DB_USER=postgres
DB_PASSWORD=12345

# Contraseña maestra para autorizar la creación (POST) y eliminación (DELETE) de productos
ADMIN_PASSWORD=tu_clave_admin