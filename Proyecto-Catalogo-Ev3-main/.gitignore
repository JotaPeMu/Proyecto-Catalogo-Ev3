# Ignorar dependencias pesadas de Node.js
# Evita subir miles de archivos de librerías que se regeneran con npm install.
node_modules/  

# Ignorar variables de entorno con contraseñas locales
# Protege tus contraseñas de PostgreSQL y la clave ADMIN_PASSWORD para que nunca queden públicas en GitHub.
.env

# Ignorar archivos temporales del sistema
# Evitan que se suban archivos ocultos de caché de miniaturas generados automáticamente por macOS y Windows.
.DS_Store
Thumbs.db
